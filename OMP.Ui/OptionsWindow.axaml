<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OMP.Ui.Models"
        xmlns:output="clr-namespace:OMP.Lib.Audio.Output;assembly=OMP.Lib"
        x:Class="OMP.Ui.OptionsWindow"
        Width="700"
        SizeToContent="Height"
        Title="Audio Routing Options">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="20">

        <TextBlock Grid.Row="0"
                   Text="Audio Routing"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <ItemsControl Grid.Row="1"
                      Name="RoutesList">

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:AudioRouteRow">

                    <Grid ColumnDefinitions="*,*,Auto,Auto,Auto,Auto"
                          Margin="0,4">

                        <TextBlock Grid.Column="0"
                                   Text="{Binding StreamLabel}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding OutputLabel}"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <ToggleButton Grid.Column="2"
                                      Name="RouteMuteButton"
                                      IsChecked="{Binding Muted, Mode=TwoWay}"
                                      IsCheckedChanged="OnRouteMuteChanged"
                                      Content="🔇"
                                      Width="32"
                                      Height="28"
                                      Margin="0,0,6,0"
                                      ToolTip.Tip="Mute this output"/>

                        <Slider Grid.Column="3"
                                Name="RouteVolumeSlider"
                                Value="{Binding Volume, Mode=TwoWay}"
                                ValueChanged="OnRouteVolumeChanged"
                                PointerCaptureLost="OnRouteVolumeReleased"
                                Minimum="0"
                                Maximum="200"
                                Width="130"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="4"
                                   Text="{Binding Volume, StringFormat={}{0:0}%}"
                                   Width="42"
                                   Margin="6,0,0,0"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="5"
                                Name="DeleteRouteButton"
                                Click="OnDeleteRoute"
                                IsEnabled="{Binding CanDelete}"
                                Content="✕"
                                Width="28"
                                Height="28"
                                Margin="6,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- Add New Route -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,15,0,0">

            <ComboBox Name="StreamSelector"
                      Width="280">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AudioStreamOption">
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox Name="OutputSelector"
                      Width="260">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="output:AudioOutput">
                        <TextBlock Text="{Binding FriendlyName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Name="AddRouteButton"
                    Content="+"
                    Width="32"/>
        </StackPanel>

        <!-- Save -->
        <Button Grid.Row="3"
                Name="SaveButton"
                Content="Save"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Width="100"/>

    </Grid>
</Window>
