<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OMP.Ui.Models"
        x:Class="OMP.Ui.OptionsWindow"
        Width="500"
        SizeToContent="Height"
        Title="Audio Routing Options">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="20">

        <TextBlock Grid.Row="0"
                   Text="Audio Routing"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <ItemsControl Grid.Row="1"
                      Name="RoutesList">

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:AudioRoute">

                    <Grid ColumnDefinitions="*,*,Auto"
                          Margin="0,4">

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Track}"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Output}"
                                   Margin="10,0"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Name="DeleteRouteButton"
                                Click="OnDeleteRoute"
                                Content="✕"
                                Width="28"
                                Height="28"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <!-- Add New Route -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,15,0,0">

            <ComboBox Name="TrackSelector"
                      Width="180"/>

            <ComboBox Name="OutputSelector"
                      Width="180"/>

            <Button Name="AddRouteButton"
                    Content="+"
                    Width="32"/>
        </StackPanel>

        <!-- Save -->
        <Button Grid.Row="3"
                Name="SaveButton"
                Content="Save"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Width="100"/>

    </Grid>
</Window>