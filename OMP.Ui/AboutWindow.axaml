<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OMP.Ui.AboutWindow"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="About">

    <StackPanel Margin="24"
                Spacing="10"
                HorizontalAlignment="Center">

        <Image Source="avares://OMP/Assets/app-icon.png"
               Width="64"
               Height="64"
               HorizontalAlignment="Center" />

        <TextBlock Name="AppNameText"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <TextBlock Name="VersionText"
                   Opacity="0.7"
                   HorizontalAlignment="Center" />

        <TextBlock Text="Licensed under PolyForm Noncommercial 1.0.0"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Width="280"
                   Margin="0,10,0,0" />

        <Button Name="GitHubButton"
                Content="View on GitHub"
                HorizontalAlignment="Center"
                Margin="0,6,0,0" />

        <Button Name="CloseButton"
                Content="Close"
                HorizontalAlignment="Center"
                Margin="0,10,0,0" />

    </StackPanel>
</Window>
