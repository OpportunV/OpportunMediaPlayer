<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OMP.Ui.AudioOutputWarningWindow"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Audio Output Unavailable">

    <StackPanel Margin="24"
                Spacing="10">

        <TextBlock Text="Audio output couldn't be initialized."
                   FontSize="15"
                   FontWeight="Bold" />

        <TextBlock Name="GuidanceText"
                   TextWrapping="Wrap" />

        <TextBlock Text="Technical detail:"
                   Opacity="0.7"
                   Margin="0,10,0,0" />

        <TextBlock Name="ReasonText"
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   FontFamily="Consolas" />

        <Button Name="CloseButton"
                Content="Close"
                HorizontalAlignment="Right"
                Margin="0,10,0,0" />

    </StackPanel>
</Window>
