<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:OMP.Ui"
    xmlns:loc="clr-namespace:OMP.Ui.Localization"
    x:Class="OMP.Ui.MainWindow"
    Icon="avares://OMP/Assets/app-icon.ico"
    Width="1200"
    Height="800"
    x:DataType="ui:MainWindow"
    DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*">

        <Menu Name="TopMenu" Grid.Row="0">
            <MenuItem Header="{x:Static loc:Strings.MainWindow_FileMenu}">
                <MenuItem Header="{x:Static loc:Strings.MainWindow_OpenMenuItem}" Name="OpenMenuItem" />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_OptionsMenuItem}" Name="OptionsMenuItem" />
                <Separator />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_ExitMenuItem}" Name="ExitMenuItem" />
            </MenuItem>
            <MenuItem Header="{x:Static loc:Strings.MainWindow_HelpMenu}">
                <MenuItem Header="{x:Static loc:Strings.MainWindow_HotkeysMenuItem}" Name="HotkeysMenuItem" />
                <MenuItem Header="{x:Static loc:Strings.MainWindow_AboutMenuItem}" Name="AboutMenuItem" />
            </MenuItem>
        </Menu>

        <Grid Name="VideoHost"
              Grid.Row="1">

            <Grid Name="VideoSurface">
                <Border Background="Black" />

                <Image Name="VideoView"
                       Stretch="Uniform" />

                <Canvas Name="SubtitleOverlay"
                        IsHitTestVisible="False" />
            </Grid>

            <Border Name="OverlayControls"
                    Background="{DynamicResource OverlayBarBackgroundBrush}"
                    VerticalAlignment="Bottom"
                    Padding="10,18,10,10"
                    Opacity="1">

                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity"
                                          Duration="0:0:0.3" />
                    </Transitions>
                </Border.Transitions>

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">

                        <Button Name="StepBackButton"
                                Classes="icon-button">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource StepBackIconGeometry}"
                                          Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Name="PlayPauseButton"
                                Classes="icon-button">
                            <Grid Width="18" Height="18">
                                <Viewbox Name="PlayIcon"
                                         Width="18"
                                         Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource PlayIconGeometry}"
                                              Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                    </Canvas>
                                </Viewbox>

                                <Viewbox Name="PauseIcon"
                                         Width="18"
                                         Height="18"
                                         IsVisible="False">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource PauseIconGeometry}"
                                              Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>

                        <Button Name="StepForwardButton"
                                Classes="icon-button">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource StepForwardIconGeometry}"
                                          Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <TextBlock Name="CurrentTimeLabel"
                                   Text="00:00"
                                   Foreground="{DynamicResource OverlayBarForegroundBrush}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas" />
                    </StackPanel>

                    <Slider Grid.Column="1"
                            Name="ProgressSlider"
                            Minimum="0"
                            Maximum="1"
                            VerticalAlignment="Center"
                            Focusable="False"
                            ToolTip.Placement="Pointer"
                            ToolTip.ShowDelay="0">
                        <Slider.Resources>
                            <!-- ReSharper disable Xaml.RedundantResource 
                            Reason: used by avalonia -->
                            <x:Double x:Key="SliderTrackThemeHeight">14</x:Double>
                            <x:Double x:Key="SliderHorizontalThumbWidth">0</x:Double>
                            <x:Double x:Key="SliderHorizontalThumbHeight">8</x:Double>
                            <x:Double x:Key="SliderHorizontalHeight">18</x:Double>
                            <!-- ReSharper restore Xaml.RedundantResource -->
                        </Slider.Resources>
                    </Slider>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">

                        <TextBlock Name="DurationLabel"
                                   Text="00:00"
                                   Foreground="{DynamicResource OverlayBarForegroundBrush}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas" />

                        <Button Name="MuteButton"
                                Classes="icon-button">
                            <Grid Width="18" Height="18">
                                <Viewbox Name="SpeakerIcon"
                                         Width="18"
                                         Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource SpeakerBodyGeometry}"
                                              Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                        <Path Data="{StaticResource SpeakerWavesGeometry}"
                                              Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                              StrokeThickness="2"
                                              StrokeLineCap="Round" />
                                    </Canvas>
                                </Viewbox>

                                <Viewbox Name="SpeakerMutedIcon"
                                         Width="18"
                                         Height="18"
                                         IsVisible="False">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource SpeakerBodyGeometry}"
                                              Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                        <Path Data="{StaticResource SpeakerMutedXGeometry}"
                                              Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                              StrokeThickness="2"
                                              StrokeLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">

                            <Slider Name="VolumeSlider"
                                    Width="120"
                                    Minimum="0"
                                    Maximum="200"
                                    Value="100"
                                    Focusable="False" />

                            <TextBlock Name="VolumeLabel"
                                       Text="100%"
                                       Width="38"
                                       Foreground="{DynamicResource OverlayBarForegroundBrush}"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Name="OutputVolumesButton"
                                Classes="icon-button"
                                ToolTip.Tip="{x:Static loc:Strings.MainWindow_OutputVolumesButtonTooltip}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource MixerLinesGeometry}"
                                          Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round" />
                                    <Path Data="{StaticResource MixerDotsGeometry}"
                                          Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Name="SpeedButton"
                                Classes="icon-button"
                                ToolTip.Tip="{x:Static loc:Strings.MainWindow_SpeedButtonTooltip}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource SpeedGaugeArcGeometry}"
                                          Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round" />
                                    <Path Data="{StaticResource SpeedGaugeNeedleGeometry}"
                                          Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <ToggleButton Name="SubtitlesButton"
                                      Classes="icon-button"
                                      ToolTip.Tip="{x:Static loc:Strings.MainWindow_SubtitlesButtonTooltip}">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource SubtitlesRectGeometry}"
                                          Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                          StrokeThickness="2"
                                          Fill="Transparent" />
                                    <Path Data="{StaticResource SubtitlesLinesGeometry}"
                                          Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>

                        <Button Name="OptionsButton"
                                Classes="icon-button">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource GearBodyGeometry}"
                                          Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                    <Path Data="{StaticResource GearTeethGeometry}"
                                          Fill="{DynamicResource OverlayBarForegroundBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Name="FullscreenButton"
                                Classes="icon-button">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource FullscreenCornersGeometry}"
                                          Stroke="{DynamicResource OverlayBarForegroundBrush}"
                                          StrokeThickness="2"
                                          StrokeLineCap="Square" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

            </Border>
        </Grid>
    </Grid>
</Window>