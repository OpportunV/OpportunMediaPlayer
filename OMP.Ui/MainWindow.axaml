<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="OMP.Ui.MainWindow"
    Width="1200"
    Height="800"
    Title="Autogen Media Player">

    <Grid RowDefinitions="Auto,*">

        <!-- TOP MENU -->
        <Menu Name="TopMenu" Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Name="OpenMenuItem" />
                <Separator />
                <MenuItem Header="E_xit" Name="ExitMenuItem" />
            </MenuItem>
        </Menu>

        <!-- VIDEO AREA -->
        <Grid Name="VideoHost"
              Grid.Row="1">

            <!-- Video Layer -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#1E1E1E" Offset="0" />
                        <GradientStop Color="#2A2A2A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <TextBlock Text="VIDEO OUTPUT"
                       Foreground="#555"
                       FontSize="32"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- Overlay Controls -->
            <Border Name="OverlayControls"
                    Background="#66000000"
                    VerticalAlignment="Bottom"
                    Padding="10"
                    Opacity="1">

                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity"
                                          Duration="0:0:0.3" />
                    </Transitions>
                </Border.Transitions>

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
                      ColumnSpacing="10">

                    <Button Grid.Column="0" Content="⏮" Name="StepBackButton" />
                    <Button Grid.Column="1" Content="▶" Name="PlayButton" />
                    <Button Grid.Column="2" Content="⏸" Name="PauseButton" />
                    <Button Grid.Column="3" Content="⏭" Name="StepForwardButton" />

                    <Slider Grid.Column="4"
                            Name="ProgressSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="0" />

                    <TextBlock Grid.Column="5"
                               Text="🔊"
                               VerticalAlignment="Center" />

                    <Slider Grid.Column="6"
                            Name="VolumeSlider"
                            Width="120"
                            Minimum="0"
                            Maximum="100"
                            Value="50" />

                    <Button Grid.Column="7"
                            Content="⚙"
                            Name="OptionsButton" />

                    <Button Grid.Column="8"
                            Content="⛶"
                            Name="FullscreenButton" />
                </Grid>

            </Border>
        </Grid>
    </Grid>


