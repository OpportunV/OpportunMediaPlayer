<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OMP.Ui.Localization"
             x:Class="OMP.Ui.Controls.SpeedFlyoutView">

    <UserControl.Styles>
        <Style Selector="ToggleButton.seg">
            <Setter Property="BorderBrush" Value="{DynamicResource FlyoutRuleBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Width="360"
                Margin="14"
                Spacing="12">

        <TextBlock Text="{x:Static loc:Strings.MainWindow_PlaybackSpeedHeader}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Opacity="0.7" />

        <Border Classes="seg-group"
                BorderBrush="{DynamicResource FlyoutForegroundBrush}"
                Opacity="1">
            <UniformGrid Name="PresetsPanel"
                         Rows="1" />
        </Border>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="9">

            <Button Grid.Column="0"
                    Name="DecreaseButton"
                    Classes="icon-button-sm ghost">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource MinusIconGeometry}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="2"
                              StrokeLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <Slider Grid.Column="1"
                    Name="SpeedSlider"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Name="IncreaseButton"
                    Classes="icon-button-sm ghost">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource PlusIconGeometry}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="2"
                              StrokeLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <TextBlock Grid.Column="3"
                       Name="SpeedValueLabel"
                       FontFamily="Consolas"
                       FontSize="12"
                       Width="46"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
