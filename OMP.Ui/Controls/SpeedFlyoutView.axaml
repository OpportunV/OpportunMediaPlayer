<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OMP.Ui.Controls.SpeedFlyoutView">

    <StackPanel Width="400"
                Margin="14"
                Spacing="12">

        <TextBlock Text="Playback speed"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <Grid Name="PresetsPanel"
              ColumnSpacing="6" />

        <TextBlock Name="SpeedValueLabel"
                   Text="1x"
                   FontFamily="Consolas"
                   FontWeight="Bold"
                   FontSize="16"
                   HorizontalAlignment="Center" />

        <Grid ColumnDefinitions="Auto,200,Auto"
              ColumnSpacing="8"
              HorizontalAlignment="Center">

            <Button Grid.Column="0"
                    Name="DecreaseButton"
                    Content="-"
                    Width="28"
                    Height="28" />

            <Slider Grid.Column="1"
                    Name="SpeedSlider"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Name="IncreaseButton"
                    Content="+"
                    Width="28"
                    Height="28" />
        </Grid>
    </StackPanel>
</UserControl>
