<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OMP.Ui.Controls.SpeedFlyoutView">

    <StackPanel Width="400"
                Margin="14"
                Spacing="12">

        <TextBlock Text="Playback speed"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />

        <Grid Name="PresetsPanel"
              ColumnSpacing="6" />

        <TextBlock Name="SpeedValueLabel"
                   Text="1x"
                   FontFamily="Consolas"
                   FontWeight="Bold"
                   FontSize="16"
                   HorizontalAlignment="Center" />

        <Grid ColumnDefinitions="Auto,200,Auto"
              ColumnSpacing="8"
              HorizontalAlignment="Center">

            <Button Grid.Column="0"
                    Name="DecreaseButton"
                    Classes="icon-button-sm">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource MinusIconGeometry}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="2"
                              StrokeLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>

            <Slider Grid.Column="1"
                    Name="SpeedSlider"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" />

            <Button Grid.Column="2"
                    Name="IncreaseButton"
                    Classes="icon-button-sm">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource PlusIconGeometry}"
                              Stroke="{Binding $parent[Button].Foreground}"
                              StrokeThickness="2"
                              StrokeLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
