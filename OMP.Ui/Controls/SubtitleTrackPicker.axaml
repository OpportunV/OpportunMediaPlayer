<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:OMP.Ui.Models"
             xmlns:loc="clr-namespace:OMP.Ui.Localization"
             x:Class="OMP.Ui.Controls.SubtitleTrackPicker">

    <Button Name="PickerButton"
            Background="{DynamicResource ComboBoxBackground}"
            BorderBrush="{DynamicResource ComboBoxBorderBrush}"
            BorderThickness="{DynamicResource ComboBoxBorderThemeThickness}"
            CornerRadius="{DynamicResource ControlCornerRadius}"
            MinHeight="32"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center"
            Padding="12,5,8,5">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Name="SelectionText"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Viewbox Grid.Column="1"
                     Width="12"
                     Height="12"
                     Margin="8,0,0,0">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource ChevronDownIconGeometry}"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Canvas>
            </Viewbox>
        </Grid>

        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel Name="FlyoutPanel"
                            Spacing="8">
                    <TextBox Name="SearchBox"
                             Watermark="{x:Static loc:Strings.Options_SearchTracksWatermark}" />
                    <ListBox Name="OptionsList"
                             MaxHeight="320"
                             SelectionMode="Single">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"
                                   x:DataType="models:SubtitleStreamOption">
                                <Setter Property="IsEnabled"
                                        Value="{Binding IsSupported}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SubtitleStreamOption">
                                <TextBlock Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Label}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Name="NoMatchesText"
                               Classes="hint"
                               Text="{x:Static loc:Strings.Options_NoMatchingTracks}"
                               Margin="4,0,4,4"
                               IsVisible="False" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
