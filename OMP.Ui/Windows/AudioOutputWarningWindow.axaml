<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OMP.Ui.Localization"
        x:Class="OMP.Ui.Windows.AudioOutputWarningWindow"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static loc:Strings.AudioWarning_Title}">

    <StackPanel Margin="22"
                Spacing="14">

        <StackPanel Spacing="5">
            <TextBlock Text="{x:Static loc:Strings.AudioWarning_Heading}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Name="GuidanceText"
                       Classes="hint"
                       FontSize="12.5"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource SettingsRuleBrush}"
                BorderThickness="2,0,0,0"
                Padding="11,2,0,2">
            <StackPanel Spacing="3">
                <TextBlock Classes="hint"
                           FontSize="11"
                           Text="{x:Static loc:Strings.AudioWarning_TechnicalDetailLabel}" />
                <TextBlock Name="ReasonText"
                           Classes="mono"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Button Name="CloseButton"
                Classes="default"
                Content="{x:Static loc:Strings.Common_Close}"
                HorizontalAlignment="Right" />

    </StackPanel>
</Window>
