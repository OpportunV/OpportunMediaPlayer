<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OMP.Ui.Localization"
        x:Class="OMP.Ui.Windows.AboutWindow"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static loc:Strings.About_Title}">

    <StackPanel Margin="24"
                Spacing="16">

        <StackPanel Orientation="Horizontal"
                    Spacing="14">
            <Image Source="avares://OMP/Assets/app-icon.png"
                   Width="44"
                   Height="44"
                   VerticalAlignment="Top" />
            <StackPanel Spacing="3"
                        VerticalAlignment="Center">
                <TextBlock Name="AppNameText"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Name="VersionText"
                           Classes="mono" />
            </StackPanel>
        </StackPanel>

        <Border Classes="rule" />

        <TextBlock Classes="hint"
                   FontSize="12"
                   Text="{x:Static loc:Strings.About_LicenseText}" />

        <Button Name="GitHubButton"
                Classes="link"
                Content="{x:Static loc:Strings.About_GitHubButton}"
                HorizontalAlignment="Left" />
    </StackPanel>
</Window>
