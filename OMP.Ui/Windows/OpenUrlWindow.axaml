<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OMP.Ui.Localization"
        x:Class="OMP.Ui.Windows.OpenUrlWindow"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{x:Static loc:Strings.OpenUrl_Title}">

    <StackPanel Margin="24"
                Spacing="10">

        <TextBlock Text="{x:Static loc:Strings.OpenUrl_Label}"
                   TextWrapping="Wrap" />

        <TextBox Name="UrlTextBox"
                 Watermark="{x:Static loc:Strings.OpenUrl_Watermark}" />

        <TextBlock Name="ErrorText"
                   Foreground="IndianRed"
                   TextWrapping="Wrap"
                   IsVisible="False" />

        <StackPanel Name="BusyPanel"
                    Orientation="Horizontal"
                    Spacing="10"
                    IsVisible="False">

            <ProgressBar IsIndeterminate="True"
                         Width="20"
                         Height="20" />

            <TextBlock Text="{x:Static loc:Strings.OpenUrl_ResolvingLabel}"
                       VerticalAlignment="Center" />

        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Name="CancelButton"
                    Content="{x:Static loc:Strings.OpenUrl_CancelButton}" />
            <Button Name="OkButton"
                    Content="{x:Static loc:Strings.OpenUrl_OkButton}" />
        </StackPanel>

    </StackPanel>
</Window>
