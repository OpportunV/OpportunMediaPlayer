<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OMP.Ui.Localization"
        xmlns:models="clr-namespace:OMP.Ui.Models"
        x:Class="OMP.Ui.Windows.SubtitleZoneEditorWindow"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        Title="{x:Static loc:Strings.SubtitleZoneEditor_NewTitle}">

    <Grid ColumnDefinitions="Auto,Auto"
          Margin="20"
          ColumnSpacing="24">

        <StackPanel Grid.Column="0"
                    Spacing="10">

            <StackPanel Orientation="Horizontal"
                        Spacing="10">
                <TextBlock Classes="hint"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_ScreenLabel}"
                           VerticalAlignment="Center" />
                <ComboBox Name="ScreenAspectRatioSelector"
                          Width="100"
                          Height="26"
                          FontFamily="Consolas"
                          FontSize="11.5" />
                <TextBlock Classes="hint"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_VideoLabel}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
                <ComboBox Name="VideoAspectRatioSelector"
                          Width="100"
                          Height="26"
                          FontFamily="Consolas"
                          FontSize="11.5" />
            </StackPanel>

            <Border Name="ScreenBorder"
                    BorderBrush="{DynamicResource SettingsRuleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Canvas Name="PreviewCanvas"
                        Width="480"
                        Height="270"
                        ClipToBounds="True">

                    <Border Name="VideoAreaBorder">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%"
                                                  EndPoint="0%,100%">
                                <GradientStop Color="#1E1E1E"
                                              Offset="0" />
                                <GradientStop Color="#0F0F0F"
                                              Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border Name="ZoneBorder"
                            Background="#264FAE7C"
                            BorderBrush="#CC4FAE7C"
                            BorderThickness="1"
                            Cursor="SizeAll">
                        <TextBlock Name="SampleText"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Name="ResizeHandle"
                            Width="12"
                            Height="12"
                            Background="#8FDBAD"
                            BorderBrush="#4FAE7C"
                            BorderThickness="1"
                            Cursor="BottomRightCorner" />

                    <TextBlock Name="DragHintText"
                               Canvas.Left="10"
                               Canvas.Top="8"
                               Classes="mono"
                               FontSize="10.5"
                               Opacity="0.55"
                               Text="{x:Static loc:Strings.SubtitleZoneEditor_DragHint}" />
                </Canvas>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Spacing="10">

            <TextBox Name="NameTextBox"
                     BorderBrush="{DynamicResource AccentLineBrush}"
                     Watermark="{x:Static loc:Strings.SubtitleZoneEditor_NameWatermark}" />
            <TextBlock Classes="hint"
                       Text="{x:Static loc:Strings.SubtitleZoneEditor_NameHint}"
                       Margin="0,-6,0,0" />

            <Border Classes="rule"
                    Margin="0,4" />

            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10">

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_FontLabel}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          Name="FontFamilySelector"
                          Width="200"
                          HorizontalAlignment="Left" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_SizeLabel}"
                           VerticalAlignment="Center" />
                <Grid Grid.Row="1" Grid.Column="1"
                      ColumnDefinitions="160,40"
                      ColumnSpacing="8"
                      HorizontalAlignment="Left">
                    <Slider Grid.Column="0"
                            Name="FontSizeSlider"
                            Minimum="2"
                            Maximum="12"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Name="FontSizeValueText"
                               Classes="mono"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_TextColorLabel}"
                           VerticalAlignment="Center" />
                <Border Grid.Row="2" Grid.Column="1"
                        Classes="seg-group"
                        Width="200"
                        Height="32"
                        HorizontalAlignment="Left">
                    <ColorPicker Name="FontColorPicker"
                                 IsAlphaEnabled="False"
                                 Width="200"
                                 Height="30"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_BgColorLabel}"
                           VerticalAlignment="Center" />
                <Border Grid.Row="3" Grid.Column="1"
                        Classes="seg-group"
                        Width="200"
                        Height="32"
                        HorizontalAlignment="Left">
                    <ColorPicker Name="BackgroundColorPicker"
                                 IsAlphaEnabled="False"
                                 Width="200"
                                 Height="30"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_BgOpacityLabel}"
                           VerticalAlignment="Center" />
                <Grid Grid.Row="4" Grid.Column="1"
                      ColumnDefinitions="160,40"
                      ColumnSpacing="8"
                      HorizontalAlignment="Left">
                    <Slider Grid.Column="0"
                            Name="BackgroundOpacitySlider"
                            Minimum="0"
                            Maximum="100"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Name="BackgroundOpacityValueText"
                               Classes="mono"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_AlignHLabel}"
                           VerticalAlignment="Center" />
                <Border Grid.Row="5" Grid.Column="1"
                        Classes="seg-group"
                        Width="200"
                        HorizontalAlignment="Left">
                    <ItemsControl Name="HorizontalAlignSelector">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HorizontalAlignmentOption">
                                <ToggleButton Classes="seg"
                                              Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsCheckedChanged="OnHorizontalAlignChanged" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="{x:Static loc:Strings.SubtitleZoneEditor_AlignVLabel}"
                           VerticalAlignment="Center" />
                <Border Grid.Row="6" Grid.Column="1"
                        Classes="seg-group"
                        Width="200"
                        HorizontalAlignment="Left">
                    <ItemsControl Name="VerticalAlignSelector">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VerticalAlignmentOption">
                                <ToggleButton Classes="seg"
                                              Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsCheckedChanged="OnVerticalAlignChanged" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Name="CancelButton"
                        Classes="link"
                        Foreground="{DynamicResource SettingsHintBrush}"
                        Padding="12,6"
                        Content="{x:Static loc:Strings.SubtitleZoneEditor_CancelButton}" />
                <Button Name="SaveButton"
                        Classes="primary-outline"
                        Padding="14,5"
                        Content="{x:Static loc:Strings.SubtitleZoneEditor_SaveButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
