<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:input="clr-namespace:OMP.Ui.Input"
        xmlns:loc="clr-namespace:OMP.Ui.Localization"
        x:Class="OMP.Ui.Windows.HotkeysWindow"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        Title="{x:Static loc:Strings.Hotkeys_Title}">

    <ItemsControl Name="HotkeysList"
                  Margin="22">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="input:HotkeyGroup">
                <StackPanel Spacing="8"
                            Margin="0,0,0,16">

                    <TextBlock Classes="column-header"
                               Text="{Binding Title}" />

                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="input:HotkeyEntry">
                                <Grid ColumnDefinitions="Auto,*"
                                      Margin="0,3">

                                    <Border Grid.Column="0"
                                            BorderBrush="{DynamicResource SettingsRuleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Classes="mono"
                                                   Text="{Binding Keys}"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Classes="hint"
                                               FontSize="12.5"
                                               Text="{Binding Description}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
